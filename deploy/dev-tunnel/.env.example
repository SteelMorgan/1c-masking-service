# Пример переменных для deploy/dev-tunnel/compose.yml. Скопируйте в .env рядом с compose.yml.
TUNNEL_COMPOSE_PROJECT=onec-v8sm-dev-tunnel
TUNNEL_CONTAINER_NAME=onec-v8sm-dev-tunnel
# Любой образ с /usr/bin/ssh
ONEC_V8SM_TUNNEL_IMAGE=ssh-client-image:latest
TUNNEL_UID=1000
TUNNEL_GID=1000
# Контейнер, в network namespace которого слушает v8-session-manager
MANAGER_CONTAINER=manager-container
MANAGER_PORT=4000
# Сервер 1С и учётная запись туннеля на нём
ONEC_HOST=onec-host
TUNNEL_SSH_USER=tunnel-user
TUNNEL_REMOTE_PORT=4000
# Внешний volume с id_ed25519 и known_hosts
TUNNEL_SECRETS_VOLUME=onec-v8sm-dev-tunnel-secrets
