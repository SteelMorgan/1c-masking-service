# Пример переменных для compose.dev.yml. Скопируйте в .env и подставьте свои значения.
MASKING_COMPOSE_PROJECT=onec-masking-service-dev
MASKING_EXPECTED_ORIGIN=http://127.0.0.1:18787
MASKING_HUMAN_PORT=18787
MASKING_RUST_LOG=info
# UID/GID процесса сервиса и ожидаемый peer UID менеджера на service.sock
MASKING_UID=1000
MASKING_GID=1000
MASKING_MANAGER_UID=1000
# Внешние volume (создаются заранее: docker volume create <имя>)
MASKING_STATE_VOLUME=masking-service-state
MASKING_SHARED_VOLUME=manager-shared-runtime
# Подкаталог общего volume, где живут service.sock / manager.sock
MASKING_SHARED_SUBPATH=run/1c-masking
